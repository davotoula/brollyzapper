# BrollyZapper guard: the credential broker (spec §3, §6).
#
# Deliberately separate from Dockerfile.server: this is the only image that ever
# gets admin.macaroon mounted into it, and it has no network listener of any
# kind. Keeping the two files separate is what makes the compose lint in d46.11
# possible.
# Base images are pinned by digest, not by tag: a tag is a mutable pointer, and
# these two are the compiler and the runtime rootfs. Refresh deliberately with
#   docker buildx imagetools inspect <image>:<tag> --format '{{.Manifest.Digest}}'
# and say in the commit message what moved (review L12).
FROM --platform=$BUILDPLATFORM golang:1.27-alpine@sha256:4cb7ac979db5fcc41cae44b2227ba5ab8a51e8807f40d9ba4dee20a0ad960b5b AS build
# The pinned digest above is the compiler, and this is what makes that true.
# With GOTOOLCHAIN unset (default "auto") a go.mod toolchain line NEWER than the
# image would be silently downloaded mid-build: the build would succeed, the
# digest pin would quietly stop determining the compiler, and nothing would say
# so. "local" is what stops that — the image's own Go compiles, always.
#
# WHAT IT DOES NOT DO is complain when go.mod asks for more than this image has.
# An earlier version of this comment said "local" turned that into a loud build
# failure naming the toolchain. It does not: under "local" a `toolchain` line is
# INERT, and only the `go` directive (the language version) can refuse. Measured
# during 0vk.35 — `toolchain go1.28.0` planted in go.mod, `--no-cache` build on a
# base shipping go1.27.1, build succeeded silently. So a floor above this image
# means the gate tests a newer Go than ships here and nothing says so, which is
# the direction govulncheck cannot see past. `make toolchain-floor` is now the
# assertion (0vk.39): it reads THIS digest, asks the registry which Go the image
# ships, and fails if go.mod's toolchain line disagrees — in either direction, in
# the local gate and in CI. So the pin and the floor still move together by hand,
# but no longer only by hand: change one without the other and the gate says so.
ENV GOTOOLCHAIN=local
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" \
    -o /out/brollyguard ./cmd/brollyguard

FROM gcr.io/distroless/static:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
COPY --from=build /out/brollyguard /brollyguard
USER nonroot:nonroot
ENTRYPOINT ["/brollyguard"]

# GHCR reads this at push time and connects the package to the named repository
# — the package page's banner, its listing under the repo, and future permission
# inheritance all follow it. Without it the connection is whatever was set last
# by hand, which after the 2026-08-31 rename pointed at the private dev repo.
LABEL org.opencontainers.image.source="https://github.com/davotoula/brollyzapper"
LABEL org.opencontainers.image.licenses="MIT"
