# BrollyZapper, plain Docker. Copy to `.env` and fill in the four values above
# the line; everything below it has a working default.
#
# The procedure these settings belong to is DEPLOYING.md §Running outside Umbrel.
#
#     cp .env.example .env && $EDITOR .env
#
# `.env` is gitignored. Keep it 0600 — ADMIN_PASSWORD is in it.

# ---------------------------------------------------------------------------
# The four an operator must decide. All four need a value on this deployment —
# ADMIN_PASSWORD included, and see its own comment for why.
# ---------------------------------------------------------------------------

# LND's data directory ON THIS HOST. Two files are mounted out of it read-only:
# tls.cert, and data/chain/bitcoin/<network>/admin.macaroon. Never the whole
# directory — it also holds wallet.db.
LND_DIR=/home/lnd/.lnd

# host:port as the CONTAINER will dial it. If LND runs in Docker on this
# project's network, that is its service name — `lnd:10009`. If LND runs on the
# host, it is the bridge gateway for the network below — `10.61.7.1:10009`.
#
# TWO EDITS TO lnd.conf, and a host LND needs both before this address works:
#
#   - LND's gRPC listens on localhost only by default, so it never answers the
#     bridge at all. Add `rpclisten=` for the address above — the gateway, or
#     0.0.0.0 to answer on every interface.
#   - LND's TLS certificate must NAME whatever you put here, or the dial fails
#     verification. Add `tlsextraip=` / `tlsextradomain=` to match, then delete
#     tls.cert and tls.key so LND regenerates them.
#
# One restart covers both.
LND_ADDRESS=10.61.7.1:10009

# Which chain directory admin.macaroon sits under: mainnet, testnet, or regtest.
LND_NETWORK=mainnet

# The admin password for the app's own login. SET ONE BEFORE THE FIRST START:
# the server REFUSES TO START without it, and says so naming this variable.
# Minimum 12 characters.
#
# Nothing invents a password for you and nothing displays one, so until you sign
# in this file holds the only copy -- keep it 0600.
#
# EDITING THIS VALUE LATER DOES NOT CHANGE THE PASSWORD. The stored hash wins
# once it exists, so a changed value here is simply ignored. Change it from
# Settings instead, which this deployment offers because the password is yours:
# on umbrelOS the platform derives it and displays it in its own UI, so there
# the app refuses the change rather than making that display wrong.
#
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Optional. Each shows its real default, EXCEPT TRUSTED_PROXIES, which is
# commented out because empty is the default and the value shown is what to use
# only if you add a reverse proxy. Uncommenting it is a decision, not a restore.
# ---------------------------------------------------------------------------

# Where the three data directories live on the host. Make it ABSOLUTE and put it
# somewhere you can create as yourself. They must be owned by the uid the
# containers run as — see RUN_AS_UID below — and umbrelOS is not here to create
# them, so you do: DEPLOYING.md §Running outside Umbrel step 3 has the one block
# that creates them and chowns them ONLY if they do not already have that uid.
#DATA_DIR=./data

# The uid and gid both containers run as. 1000 is right on umbrelOS, where the
# app data is created 1000:1000 — but it is a DEFAULT, not an instruction, and
# on this host the pair must ALSO be able to READ the two files mounted out of
# LND_DIR:
#
#     ls -l /home/lnd/.lnd/tls.cert /home/lnd/.lnd/data/chain/bitcoin/mainnet/admin.macaroon
#
# LND usually writes those owned by its own user at mode 0600, so a container
# running as 1000 gets permission denied on a read-only mount. The guard does not
# crash -- it stays up and logs `could not copy tls.cert into the credential
# volume` and `could not bake the receive macaroon yet`, and the node never links.
# Two ways out, and either is fine:
#
#   - set RUN_AS_UID and RUN_AS_GID to what owns them —
#     `stat -c '%u %g' /home/lnd/.lnd/tls.cert` reads both, which beats guessing
#     a username — and chown the data directories to the same pair; or
#   - add a group both can read through: chgrp that group onto the two files,
#     chmod g+r them, and set RUN_AS_GID to it.
#
#RUN_AS_UID=1000
#RUN_AS_GID=1000

# The published port for the web interface.
#HTTP_PORT=8080

# Signs session cookies. LEAVE EMPTY: the server generates one on first start
# and persists it under DATA_DIR. Set it only to keep sessions valid across a
# wipe of the server's data directory.
#SESSION_SECRET=

# NOT A DEFAULT — the default is EMPTY, and empty trusts nothing, which is
# correct when the port is published directly: the TCP peer is then the client.
# The value below is what to set ONLY if you put a reverse proxy in front of the
# app on the app's own network. Turning it on makes the app believe an
# X-Forwarded-For header from that range, so anything else on that network can
# then choose the address the rate limiter counts and the audit trail records.
#TRUSTED_PROXIES=10.61.7.0/24

# The guard's INITIAL caps in msat, not ceilings: they seed its stored limits on
# first start. Afterwards the operator lowers either freely from the Security
# page, and raises either through the one-time code ceremony.
#
# THEY BOUND REAL FUNDS, which is what "initial" above does not say. They seed
# the 24-hour and per-payment limits OPERATING.md §Sending describes — what a
# wallet paired over NWC could spend from your node once sending is enabled, and
# so the amount you are willing to lose to a compromised server. The operator
# moves them afterwards; this file decides where they start. Set them
# deliberately rather than leaving a number that suited somebody else's node.
#
# On a test install, set them small enough that being wrong costs nothing. The
# September 2026 field trip used 5,000 and 1,000 sats:
#
#     GUARD_MAX_SPEND_MSAT=5000000
#     GUARD_MAX_PAYMENT_MSAT=1000000
#
#GUARD_MAX_SPEND_MSAT=100000000
#GUARD_MAX_PAYMENT_MSAT=25000000

# Whether sending may EVER be enabled on this deployment. A fresh install is
# receive-only either way; false means no in-app action can change that, and the
# Sending page says so rather than offering a ceremony that cannot work.
#GUARD_ALLOW_SENDING=true

# DEBUG, INFO, WARN or ERROR.
#LOG_LEVEL=INFO
